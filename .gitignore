# ==============================================================================
# BalancedTeam - Comprehensive .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Maven & Java Build Output
# ------------------------------------------------------------------------------
target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Maven shade plugin / release plugin temporary files
dependency-reduced-pom.xml
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# JVM crash logs & core dumps
hs_err_pid*
replay_pid*

# ------------------------------------------------------------------------------
# 2. IDE & Editor Files
# ------------------------------------------------------------------------------
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/

# Visual Studio Code
.vscode/
*.code-workspace

# Eclipse
.classpath
.project
.settings/
.factorypath
.apt_generated/
.springBeans
.sts4-cache/

# NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbdist/
nbactions.xml
nb-configuration.xml

# Vim / Emacs / Sublime
*~
*.swp
*.swo
.*.swp
.*.swo
.#*
*#
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# 3. Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# 4. Minecraft Server Runtime & Test Server Environments
# ------------------------------------------------------------------------------
# Local test server directories
run/
server/
test-server/
test-run/

# Server runtime logs, caches & libraries
logs/
cache/
libraries/
plugins/
world/
world_nether/
world_the_end/

# Server config & cache overrides
eula.txt
server.properties
banned-players.json
banned-ips.json
ops.json
whitelist.json
usercache.json
version_history.json
paper-global.yml
purpur.yml
spigot.yml
bukkit.yml

# ------------------------------------------------------------------------------
# 5. Database, Log & Local Data Files
# ------------------------------------------------------------------------------
*.log
*.log.*
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
*.db-journal

# Plugin runtime user data folder (e.g. data/user_languages.yml)
data/

# ------------------------------------------------------------------------------
# 6. Environment & Web/Node Artifacts (Prevent AI Studio / Node Pollution)
# ------------------------------------------------------------------------------
node_modules/
package.json
package-lock.json
yarn.lock
pnpm-lock.yaml
server.js
.dev.env.json
.vite/
dist/
*.tmp
